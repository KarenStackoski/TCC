# Domínio do site Jira, sem https:// e sem barra final
# Ex.: stackoskikaren.atlassian.net
JIRA_DOMAIN=

# E-mail da conta usada para gerar o API token
JIRA_EMAIL=

# API token gerado em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Chave da API da Cohere (etapa 2/3 — plano gratuito)
COHERE_API_KEY=

# Chave da API da Anthropic/Claude (etapa 2/3)
ANTHROPIC_API_KEY=
